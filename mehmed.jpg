    function holdTurnDowns(request) {
      HELD_HANDLERS.forEach(function (name) {
        var handler = request[name];
        if (typeof handler !== "function" || handler.gatewayPassHolding) return;

        var holding = request[name] = function () {
          if (request.gatewayPassReopening || held(request)) return;
