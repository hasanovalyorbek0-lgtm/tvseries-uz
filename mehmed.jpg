;
    var imageLanguageDataSource = new kendo.data.DataSource({
      schema: {
        model: {
          id: "i18n_tag"
        }
      },
      data: languageData,
      accentFoldingFiltering: "tr-TR",
      sort: {
        field: "native_name",
        dir: "asc"
      }
    });

    var sortedData;
    imageLanguageDataSource.fetch(function() {
      sortedData = imageLanguageDataSource.view();
    });

    sortedLanguageData = sortedData;
  };

  window.PageReady().then(function(ready) {

    buildSortedLanguageData();
    renderImageLanguageDropdowns(sortedLanguageData);

    $("a.image_sort_toggle").on("click", function(e) {
      e.preventDefault();
      $(".image_sort_options").toggleClass("hidden");
    });

    $("button.open_gallery").on("click", function(e) {
      e.preventDefault();
      var imageList = [];
      $("div.results li.card > div.image_content > a[href*='/original/']").each(function() {
        var href = this.getAttribute("href");
        var filename = href.split("/").pop();
        var card = $(this).closest("li.card");
        var meta = card.find("div.meta");
        var dimensions = null;
        meta.find("label").each(function() {
          if ($(this).text().trim() === "Size") {
            var sizeText = $(this).next("p").text().trim();
            dimensions = sizeText.match(/(\d+)\s*x\s*(\d+)/i);
          }
        });
        var addedBy = meta.find("a[href^='/u/']").first();

        imageList.push({
          src: href,
          filename: filename,
          info: {
            width: dimensions ? parseInt(dimensions[1]) : null,
            height: dimensions ? parseInt(dimensions[2]) : null,
            uploaded_by: addedBy.length ? addedBy.text().trim() : null,
            uploaded_by_url: addedBy.length ? addedBy.attr("href") : null,
            original_url: href
          }
        });
      });

      if (imageList.length > 0 && window.TMDbImageGallery) {
        window.TMDbImageGallery.open(imageList, 0);
      }
    });

    $("button.open_gallery").tmdbTooltip({
      themeClass: "tmdb_theme",
      position: "top"
    }).data("kendoTooltip");

    $(document).on("click", function(e) {
      if (!$(e.target).closest(".image_sort_menu").length) {
        $(".image_sort_options").addClass("hidden");
      }
    });

    $("a.image_sort_toggle").tmdbTooltip({
      themeClass: "tmdb_theme",
      position: "top"
    }).data("kendoTooltip");

    $("div.results").tmdbTooltip({
      themeClass: "tmdb_theme flex",
      filter: "span.glyphicons.tooltip",
      position: "top",
      width: 200,
      content: function(e) {
        var target = e.target.attr('element');
        return $('div.' + target + '_helper').html();
      }
    }).data("kendoTooltip");

    $(".needs_moderation").tmdbTooltip({
      themeClass: "tmdb_theme",
      filter: "span",
      position: "top",
      width: "auto"
    });


    $("div.meta").kendoTooltip({
      filter: "span.glyphicons-remove-sign.ratio",
      position: "right",
    }).data("kendoTooltip");

    $("a.add_image.tooltip").tmdbTooltip({
      themeClass: "tmdb_theme",
      position: "top"
    }).data("kendoTooltip");

    $("a.group_similar_toggle.tooltip").tmdbTooltip({
      themeClass: "tmdb_theme",
      position: "top"
    }).data("kendoTooltip");




    function setStackExpanded(stackContainer, expanded) {
      if (!stackContainer || !stackContainer.length) {
        return;
      }

      var stackList = stackContainer.closest(".image_stacks");
      var allItems = stackList.length ? stackList.children("li") : $();
      var allStacks = stackList.length ? stackList.children("li.image_stack") : $();

      if (expanded) {
        allStacks.filter(":not(.is-collapsed)").not(stackContainer).each(function() {
          $(this).addClass("is-collapsed");
        });
        allItems.css("order", "");

        stackContainer.find(".image_stack_expanded_panel img").each(function() {
          $(this).attr("loading", "eager");
          $(this).attr("decoding", "sync");
          $(this).attr("fetchpriority", "high");
        });

        stackContainer.removeClass("is-collapsed");

        if (stackList.length && allItems.length > 1) {
          var numCols = window.getComputedStyle(stackList[0])
            .getPropertyValue("grid-template-columns").split(" ").length;
          var index = allItems.index(stackContainer);
          var colPosition = index % numCols;

          if (colPosition > 0) {
            var rowStart = index - colPosition;
            allItems.each(function(i) {
              if (i === index) {
                $(this).css("order", rowStart);
              } else if (i >= rowStart && i < index) {
                $(this).css("order", i + 1);
              } else {
                $(this).css("order", i);
              }
            });
          }
        }
      } else {
        stackContainer.addClass("is-collapsed");
        allItems.css("order", "");
      }

    }

    $("div.results").on("click", "button.image_stack_preview_item", function(e) {
      e.preventDefault();

      var stackId = $(this).data("stack-id");
      var stackContainer = $(`li.image_stack[data-stack-id='${stackId}']`);
      var isExpandable = stackContainer.attr("data-expandable") === "true";

      if (!isExpandable || !stackContainer.hasClass("is-collapsed")) {
        return;
      }

      setStackExpanded(stackContainer, true);
      var rect = stackContainer[0].getBoundingClientRect();
      if (rect.top < 64) {
        window.scrollBy({ top: rect.top - 64, behavior: "smooth" });
      }
    });

    $(document).on("click", function(e) {
      var target = $(e.target);
      if (target.closest(".k-overlay, .k-dialog, .k-window, .k-animation-container, .k-tooltip").length) {
        return;
      }

      $("li.image_stack:not(.is-collapsed)").each(function() {
        var stackContainer = $(this);
        if (!stackContainer.is(target) && !stackContainer.has(target).length) {
          setStackExpanded(stackContainer, false);
        }
      });
    });

    // Preview stacks are key UI affordances; load their images eagerly to avoid blank placeholders.
    $("button.image_stack_preview_item img").each(function() {
      $(this).attr("loading", "eager");
      $(this).attr("decoding", "sync");
      $(this).attr("fetchpriority", "high");
    });

  });
</script>


