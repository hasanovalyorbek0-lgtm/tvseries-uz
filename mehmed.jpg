<script async src="/assets/components/tmdb-image-gallery-2f6d754a93acd03691caebd8a025039ea2f9a5ef68964c23b0c8eb8c5d3d79c5.js"></script>

<script type="text/javascript" charset="utf-8">
  function renderImageLanguageDropdowns(sortedData) {
    var $results = $("div.results");

    $('.kendo_image_language_dropdown').each(function(i) {
      var item = $(this);
      item.removeClass("kendo_image_language_dropdown");

      var card = item.closest("li.card");
      var image_id = card.data("image-id");
      var image_language = item.data("language");
      var image_locked = item.data("locked");
      var image_kind = item.data("kind");

      item.kendoDropDownList({
        autoWidth: true,
        height: 300,
        filter: "contains",
        dataTextField: "native_name",
        dataValueField: "i18n_tag",
        dataSource: sortedData,
        enable: !image_locked,
        template: '#= data.native_name # (#= data.i18n_tag #)',
        valueTemplate: '#= data.native_name # (#= data.i18n_tag #)',
        virtual: {
          valueMapper: function(options) {
            var indices = [];

            for (var i = 0; i < this.dataSource.options.data.length; i++) {
              if (this.dataSource.options.data[i].i18n_tag === options.value) {
                indices.push(i);
                break;
              }
            }

            options.success(indices);
          }
        },
        close: function(e) {
          var filters = this.dataSource.filter();
          if (filters) {
            this.dataSource.filter({});
          }
        },
        filtering: function(e) {
          var filterValue = e.filter != undefined ? e.filter.value : "";
          e.preventDefault();

          this.dataSource.filter({
            logic: "or",
            filters: [
              {
                field: "folded_name",
                operator: "contains",
                value: filterValue
              },
              {
                field: "english_name",
                operator: "contains",
                value: filterValue
              },
              {
                field: "native_name",
                operator: "contains",
                value: filterValue
              }
            ]
          });
        },
        change: function(e) {
          selected_language = this.value();
          card.css({ opacity: 0.4, 'pointer-events': 'none' });

          $.ajax({
            url: kendo.format('/image/{0}/language', image_id),
            type: 'POST',
            data: {
              image_language: selected_language,
              media_id: $results.data("media-id"),
              media_type: $results.data("media-type"),
              image_type: image_kind
            },
            beforeSend: function() {
              activatePageLoader();
            }
          }).fail(function() {
            card.css({ opacity: 1, 'pointer-events': '' });
            deactivatePageLoader();
            showError('Bir problem oluştu.');
          }).done(function(response) {
            deactivatePageLoader();

            if (response.failure) {
              card.css({ opacity: 1, 'pointer-events': '' });
              showError('Bir problem oluştu.');
            }

            if (response.success) {
              if (selected_language != image_language) {
                card.remove();
              } else {
                card.css({ opacity: 1, 'pointer-events': '' });
              }

              showSuccess('Dil güncellendi.', 'Başarılı');
            }
          });
        }
      });
    });
  };

