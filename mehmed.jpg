    xhr.abort = function () {
      var attempt = this.gatewayPassAttempt;
      this.gatewayPassAttempt = null;
      var result = nativeAbort.apply(this, arguments);

      // As far as the browser knows, a request waiting to be sent again is done, so aborting it fires nothing.
