  (function () {
    if (typeof fetch === "undefined" || typeof Promise === "undefined" || typeof URL === "undefined") return;

    var nativeFetch = window.fetch;
    var FRESH_FOR = 5 * 60 * 1000;
    var WAIT_AT_MOST = 3000;
    var pending = null;
    var fetchedAt = 0;

    function store(pass) {
      if (!pass || !pass.cookie || !pass.token) return;

      document.cookie = pass.cookie + "=" + pass.token + "; path=/; max-age=" + pass.max_age +
        "; SameSite=Lax" + (location.protocol === "https:" ? "; Secure" : "");
    }

    // Resolves once there's a pass fetched in the last FRESH_FOR, or after WAIT_AT_MOST; never rejects. With `after`,
    // only one fetched after that time will do: the gateway turned down the pass a request went out with at `after`.
    function refresh(after) {
      var fresh = after ? fetchedAt > after : Date.now() - fetchedAt < FRESH_FOR;
      if (pending && fresh) return pending;

      fetchedAt = Date.now();
      pending = new Promise(function (resolve) {
        setTimeout(resolve, WAIT_AT_MOST);

        nativeFetch.call(window, "/__gateway/pass", { credentials: "same-origin", cache: "no-store" })
          .then(function (response) { return response.status === 200 ? response.json() : null; })
          .then(function (pass) {
            if (pass) store(pass); else fetchedAt = 0;
          })
          .catch(function () { fetchedAt = 0; })
          .then(resolve);
      });
      return pending;
    }

    function isWrite(method, url) {
      if (!/^(POST|PUT|PATCH|DELETE)$/i.test(method || "")) return false;

      try {
        return new URL(url, location.href).origin === location.origin;
      } catch (error) {
        return false;
      }
    }

    function turnedDown(status, header) {
      return status === 403 && header === "required";
    }

    window.withGatewayPass = function (callback) {
      refresh().then(callback);
    };

    window.fetch = function (input, init) {
      var args = arguments;
      var method = (init && init.method) || (input && input.method) || "GET";
      var url = (input && input.url) || String(input);
      if (!isWrite(method, url)) return nativeFetch.apply(window, args);

      // A Request's body can only be read once, so keep a copy to send again. A stream body can't be sent twice.
      var again = null;
      try {
        var streamed = init && typeof ReadableStream !== "undefined" && init.body instanceof ReadableStream;
        if (!streamed) again = input instanceof Request ? [input.clone(), init] : args;
      } catch (error) {}

      var sentAt;
      return refresh()
        .then(function () {
          sentAt = Date.now();
          return nativeFetch.apply(window, args);
        })
        .then(function (response) {
          if (!again || !turnedDown(response.status, response.headers.get("X-Gateway-Pass"))) return response;

          return refresh(sentAt).then(function () { return nativeFetch.apply(window, again); });
        });
    };

    // $.ajax and anything else on XMLHttpRequest. Synchronous requests can't wait, so they go as they are. A write
    // that's turned down is opened and sent again on the same object, and until then the page's onload, onloadend and
    // onreadystatechange handlers (what jQuery's XHR transport and our own code use) are held back, so they only see
    // the final response. Listeners added with addEventListener see both.
    //
    // Each send is an attempt; open() and abort() end it, so a send or resend still waiting for a pass is dropped
    // rather than sent over whatever the request is used for next.
    var xhr = XMLHttpRequest.prototype;
    var nativeOpen = xhr.open;
    var nativeSend = xhr.send;
    var nativeAbort = xhr.abort;
    var nativeSetRequestHeader = xhr.setRequestHeader;
    var HELD_HANDLERS = ["onload", "onloadend", "onreadystatechange"];
    var slice = Array.prototype.slice;

    xhr.open = function (method, url, async) {
      if (!this.gatewayPassReopening) {
        this.gatewayPassAttempt = null;
        this.gatewayPassWrite = async !== false && isWrite(method, url);
        this.gatewayPassOpen = slice.call(arguments);
        this.gatewayPassHeaders = [];
