    <style>
    html {
      --primaryRgb: 31.5, 10.5, 10.5;
      --primaryColor: rgba(var(--primaryRgb), 1);
      --primaryFill: var(--primaryColor);
      --primaryColorContrast: #ffffff;
    }


    div.header {
      background: linear-gradient(to bottom right, rgba(var(--primaryRgb), 1), rgba(var(--primaryRgb), 0.84));
    }

    div.collapsible-menu .collapsible-menu-header {
      color: var(--primaryColorContrast);
    }

    div.collapsible-menu .collapsible-menu-header.background_color {
      background-color: var(--primaryFill);
    }

    html:not([data-theme="dark"]) div.collapsible-menu,
    html:not([data-theme="dark"]) div.segmented-toggle {
      --pill-fill: var(--primaryColor);
      --pill-text: var(--primaryColorContrast);
    }

    section.inner_content a, section.media_panel div.menu ul li.active a {
      color: var(--text);
    }

    section.media_panel div.menu ul li a:hover {
      text-decoration: none;
      color: color-mix(in srgb, var(--text) 50%, transparent);
    }

    section.inner_content a:hover {
      color: color-mix(in srgb, var(--text) 50%, transparent);
      text-decoration: underline;
      text-decoration-color: color-mix(in srgb, currentColor 50%, transparent);
      text-underline-offset: 3px;
    }

    section.media_panel div.menu ul li.active {
      border-bottom-color: var(--text);
    }

      
      section.inner_content div.header div.single_column *, section.inner_content div.header div.single_column a {
        color: #fff;
      }

      section.inner_content div.header div.single_column a:hover {
        color: rgba(255,255,255,0.7);
      }

      section.inner_content div.header div.single_column div.facts span.certification {
        border: 1px solid rgba(255,255,255,0.6);
        color: rgba(255,255,255,0.6);
      }

      p.new_button.rounded-legacy a span, section.inner_content section.header ul.actions li.video span,
      section.inner_content section.header div.trailer a span,
      div.second_header .vibes_tooltip {
        --icon-color: #fff;
      }
      

    p.new_button.rounded-legacy, section.content_score div.content_score div, div.leaderboard div.histogram div.bar span {
      border-color: var(--primaryFill);
      background-color: var(--primaryFill);
      color: var(--primaryColorContrast);
    }

    p.new_button.rounded-legacy a, section.content_score div.content_score div p {
      color: var(--primaryColorContrast);
    }

    ul.consensus_reaction_items li {
      background-color: var(--primaryColor);
    }

    div.vibes_label {
      color: var(--primaryColorContrast);
    }

      div.header.large.first {
        border-bottom: 1px solid var(--primaryColor);
        background-position: left calc((50vw - 170px) - 340px) top;
        background-size: cover;
        background-repeat: no-repeat;
        background-image: url('https://media.themoviedb.org/t/p/w1920_and_h800_multi_faces/bJxf4Y8UKOBsWoE3gB6N0hfB04G.jpg');
      }

      @media only screen and (min-width: 1900px) {
        div.header.large.first {
          background-size: auto;
        }
      }

      section.inner_content div.custom_bg {
        background-image: linear-gradient(to right, rgba(var(--primaryRgb), 1) calc((50vw - 170px) - 340px), rgba(var(--primaryRgb), 0.84) 50%, rgba(var(--primaryRgb), 0.84) 100%);
      }
</style>


