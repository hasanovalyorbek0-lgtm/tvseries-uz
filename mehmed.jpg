    <div id="keyboard_shortcuts_popup" class="hide">
      <div class="content k-flex-col">
        <div class="keyboard_shortcuts">
          <div class="column">
            <h3>Genel</h3>
            <div><span>s</span> arama çubuğuna odaklan</div>
            <div><span>p</span> profil menüsünü aç</div>
            <div><span>esc</span> açık bir pencereyi kapat</div>
            <div><span>?</span> klavye kısayol penceresini aç</div>

            <h3>Medya sayfalarında</h3>
            <div><span>b</span> geri git (veya uygulanabilirse ana ekrana)</div>
            <div><span>e</span> sayfayı düzenlemeye git</div>

            <h3>TV sezonu sayfalarında</h3>
            <div><span>&#8594;</span> (sağa ok) sonraki sezona git</div>
            <div><span>&#8592;</span> (sol ok) önceki sezona git</div>

            <h3>TV bölüm sayfalarında</h3>
            <div><span>&#8594;</span> (sağa ok) sonraki bölüme git</div>
            <div><span>&#8592;</span> (sol ok) önceki bölüme git</div>

            <h3>Tüm görüntü sayfalarında</h3>
            <div><span>a</span> resim ekle penceresini aç</div>
          </div>

          <div class="column">
            <h3>Tüm düzenleme sayfalarında</h3>
            <div><span>t</span> çeviri seçiciyi aç</div>
            <div><span>ctrl</span>+ <span>s</span> formu gönder</div>

            <h3>Tartışma sayfalarında</h3>
            <div><span>n</span> yeni tartışma oluştur</div>
            <div><span>w</span> izleme durumunu değiştir</div>
            <div><span>p</span> umumi/hususi değiştir</div>
            <div><span>c</span> kapalı/açık değiştir</div>
            <div><span>a</span> etkinliği aç</div>
            <div><span>r</span> tartışmayı yanıtla</div>
            <div><span>l</span> son yanıta git</div>
            <div><span>ctrl</span>+ <span>enter</span> mesajını gönder</div>
            <div><span>&#8594;</span> (sağa ok) sonraki sayfa</div>
            <div><span>&#8592;</span> (sol ok) önceki sayfa</div>
          </div>
        </div>

        <div class="keyboard_shortcuts k-flex-col k-mt-6 k-mb-3">
