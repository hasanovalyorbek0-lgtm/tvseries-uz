      var attempt = request.gatewayPassAttempt = { body: slice.call(arguments), resent: false, waiting: false };
      refresh().then(function () {
        if (request.gatewayPassAttempt !== attempt) return;

        attempt.sentAt = Date.now();
        holdTurnDowns(request);
        nativeSend.apply(request, attempt.body);
