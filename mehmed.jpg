    <script id="slim_multi_search_template" type="text/x-kendo-tmpl">
      # if (data.media_type == 'movie') { #
        <div class="slim_search_results slim">
          <div class="wrapper">
            <div class="glyphicons film"></div>
            <p>#= data.name # <span>filmlerde</span></p>
          </div>
        </div>
      # } else if (data.media_type == 'tv') { #
        <div class="slim_search_results slim">
          <div class="wrapper">
            <div class="glyphicons tv"></div>
            <p>#= data.name # <span>TV dizilerinde</span></p>
          </div>
        </div>
