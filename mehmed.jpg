      }
      return result;
    };

    // Forms: held back until the pass is there, then submitted again with the same button, so the page's own submit
    // handlers only run once. Browsers without requestSubmit submit as they are.
    if (typeof HTMLFormElement !== "undefined" && HTMLFormElement.prototype.requestSubmit) {
      document.addEventListener("submit", function (event) {
        var form = event.target;
        if (form.gatewayPassReady) return;

        var submitter = event.submitter && event.submitter.form === form ? event.submitter : null;
        var method = (submitter && submitter.getAttribute("formmethod")) || form.getAttribute("method");
        var action = (submitter && submitter.getAttribute("formaction")) || form.action;
        if (!isWrite(method, action)) return;

        event.preventDefault();
        event.stopImmediatePropagation();

        // From a timer, not straight from the promise: with a pass already there, the promise callback runs while the
        // browser is still firing this submit event (after a real click or Enter), and it ignores requestSubmit then.
        refresh().then(function () {
          setTimeout(function () {
            form.gatewayPassReady = true;
            try {
              form.requestSubmit(submitter || undefined);
            } finally {
              form.gatewayPassReady = false;
            }
          }, 0);
        });
      }, true);
    }

