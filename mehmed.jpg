<input type="hidden" name="altcha_unsupported" value="">
<script >
  window.tmdbAltcha = window.tmdbAltcha || (function () {
    var SETTLE_TIMEOUT = 20000;
    var loading = null;

    function load() {
      if (!loading) {
        loading = new Promise(function (resolve, reject) {
          if (defined()) return resolve();

          var script = document.createElement("script");
          script.src = "/assets/altcha-367fa7079ab188a3364ac002f346209664c9348b9f05c8c1110498f754d5b38a.js";
          script.async = true;
          script.onload = resolve;
          script.onerror = function () {
            loading = null;
            reject(new Error("altcha.js failed to load"));
          };
          document.head.appendChild(script);
        });
      }
      return loading;
    }

    // Without custom elements or requestSubmit (Safari before 16, Chrome before 76, Firefox before 75), or when the
    // widget's script doesn't define it, as a browser that can't parse it doesn't. The form is turned down either way;
    // this only changes what the server says.
    function markUnsupported(form) {
      var field = form.querySelector("input[name=altcha_unsupported]");
      if (field) field.value = "1";
    }

    function defined() {
      return !!(window.customElements && customElements.get("altcha-widget"));
    }

    function state(widget) {
      return widget && typeof widget.getState === "function" ? widget.getState() : null;
    }

    // Resolves once the widget has a solution, gives up, or SETTLE_TIMEOUT passes.
    function settled(widget) {
      if (!widget) return Promise.resolve();

      return load().then(function () {
        return new Promise(function (resolve) {
          var current = state(widget);
          if (current === "verified" || current === "error") return resolve();

          var timer = setTimeout(finish, SETTLE_TIMEOUT);
          // The widget starts by itself once it loads, and a second verify() would abort that one with an error, so
          // only start it when it's expired (the page was left open) or still hasn't started a moment later (reset
          // by a back navigation).
          var nudge = setTimeout(function () {
            var now = state(widget);
            if (now === "expired" || now === "unverified") widget.verify();
          }, current === "expired" ? 0 : 1000);
          function finish() {
            clearTimeout(timer);
            clearTimeout(nudge);
            widget.removeEventListener("statechange", changed);
            resolve();
          }
          function changed(event) {
            var next = event.detail && event.detail.state;
            if (next === "verified" || next === "error") finish();
          }
          widget.addEventListener("statechange", changed);
        });
      }, function () {});
    }

    // A fresh solution for a form sent over AJAX that may be sent again, as each one only counts once.
    function renew(widget) {
      if (!widget || typeof widget.reset !== "function") return;

      widget.reset();
      widget.verify();
    }

    function bind(widget) {
      var form = widget.closest("form");
      if (!form || form.tmdbAltchaBound) return;
      form.tmdbAltchaBound = true;

      if (!window.customElements || !HTMLFormElement.prototype.requestSubmit) markUnsupported(form);
      form.addEventListener("focusin", function () {
        load().then(function () {
          if (!defined()) markUnsupported(form);
        }, function () {});
      }, { once: true });

      if (widget.getAttribute("data-altcha-hold-submit") !== "true" || !HTMLFormElement.prototype.requestSubmit) return;

      // On the form rather than the document, so it runs after layouts/_gateway_pass.erb has the pass.
      form.addEventListener("submit", function (event) {
        if (form.tmdbAltchaReady || state(widget) === "verified") return;

        event.preventDefault();
        event.stopImmediatePropagation();

        var submitter = event.submitter && event.submitter.form === form ? event.submitter : null;
        // From a timer, as in layouts/_gateway_pass.erb: requestSubmit does nothing while this submit event is firing.
        settled(widget).then(function () {
          setTimeout(function () {
            form.tmdbAltchaReady = true;
            try {
              form.requestSubmit(submitter || undefined);
            } finally {
