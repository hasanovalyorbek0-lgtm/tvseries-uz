Slovence (sl-SI)","native_name":"Slovence","english_name":"Slovenian (sl-SI)","i18n_tag":"sl-SI"},{"folded_name":"Somali Dili (so-SO)","native_name":"Somali Dili","english_name":"Somali (so-SO)","i18n_tag":"so-SO"},{"folded_name":"Arnavutca (sq-AL)","native_name":"Arnavutça","english_name":"Albanian (sq-AL)","i18n_tag":"sq-AL"},{"folded_name":"Sirpca (sr-RS)","native_name":"Sırpça","english_name":"Serbian (sr-RS)","i18n_tag":"sr-RS"},{"folded_name":"Isvecce (sv-SE)","native_name":"İsveçce","english_name":"Swedish (sv-SE)","i18n_tag":"sv-SE"},{"folded_name":"Tamilce (ta-IN)","native_name":"Tamilce","english_name":"Tamil (ta-IN)","i18n_tag":"ta-IN"},{"folded_name":"Telugu (te-IN)","native_name":"Telugu","english_name":"Telugu (te-IN)","i18n_tag":"te-IN"},{"folded_name":"Taylandca (th-TH)","native_name":"Taylandça","english_name":"Thai (th-TH)","i18n_tag":"th-TH"},{"folded_name":"Turkce (tr-TR)","native_name":"Türkçe","english_name":"Turkish (tr-TR)","i18n_tag":"tr-TR"},{"folded_name":"Ukraynaca (uk-UA)","native_name":"Ukraynaca","english_name":"Ukrainian (uk-UA)","i18n_tag":"uk-UA"},{"folded_name":"Ozbekce (uz-UZ)","native_name":"Özbekçe","english_name":"Uzbek (uz-UZ)","i18n_tag":"uz-UZ"},{"folded_name":"Vietnamca (vi-VN)","native_name":"Vietnamca","english_name":"Vietnamese (vi-VN)","i18n_tag":"vi-VN"},{"folded_name":"Cince (zh-CN)","native_name":"Çince","english_name":"Mandarin (zh-CN)","i18n_tag":"zh-CN"},{"folded_name":"Cince (zh-HK)","native_name":"Çince","english_name":"Mandarin (zh-HK)","i18n_tag":"zh-HK"},{"folded_name":"Cince (zh-SG)","native_name":"Çince","english_name":"Mandarin (zh-SG)","i18n_tag":"zh-SG"},{"folded_name":"Cince (zh-TW)","native_name":"Çince","english_name":"Mandarin (zh-TW)","i18n_tag":"zh-TW"}]
,
          sort: { field: "native_name", dir: "asc" }
        });
        footerLanguageDataSource.read();
        footerLanguageDataSource.pushDestroy({"i18n_tag":"xx-XX"});

        $("#footer_language").kendoDropDownList({
          autoWidth: true,
          height: 300,
          filter: "contains",
          dataTextField: "native_name",
          dataValueField: "i18n_tag",
          dataSource: footerLanguageDataSource,
          template: '#= data.native_name # (#= data.i18n_tag #)',
          valueTemplate: '#= data.native_name # (#= data.i18n_tag #)',
          change: function() {
            $("#footer_language_save").removeClass("hide");
          },
          filtering: function(e) {
            var filterValue = e.filter != undefined ? e.filter.value : "";
            e.preventDefault();
            this.dataSource.filter({
              logic: "or",
              filters: [
                { field: "folded_name", operator: "contains", value: filterValue },
                { field: "english_name", operator: "contains", value: filterValue },
                { field: "native_name", operator: "contains", value: filterValue }
              ]
            });
          }
        });

        $("#footer_language_save").on("click", function(e) {
          e.preventDefault();
          var selectedLanguage = $("#footer_language").data("kendoDropDownList").value();
          $.post({
            url: '/set_i18n?language=tr-TR',
            dataType: "json",
            data: { language: selectedLanguage }
          }).done(function(response) {
            if (response.success) {
              window.location.reload();
            } else {
              showError();
            }
          }).fail(function() {
            showError();
          });
        });

        var seach_redirect_template = "/search{0}?language=tr-TR&query=%7B1%7D";
        var processing_selected_item = false;

        function processSelectedItem(event) {
          var dataItem = null;
          var media_type = null;
          var search_value = '';
          var selected_item = '';

          if (event == null) {
            dataItem = $("#search_v4").data("kendoAutoComplete").value();
          } else {
            dataItem = event.dataItem;
          }

          // The plain title rows, and the trending ones shown before a search: these open on Top Results, since the
          // name alone doesn't say which kind of result was meant.
          if ( typeof(dataItem) == 'string' ) {
            try {
              search_value = $(dataItem).data('search-name');
            } catch(error) {}

            search_value = search_value || dataItem;
            selected_item = kendo.format(decodeURI(seach_redirect_template), '', encodeURIComponent(search_value));
          // This is the returned items from a search
          } else {
            switch(dataItem.media_type) {
              case 'movie':
                selected_item = kendo.format(decodeURI(seach_redirect_template), '/movie', encodeURIComponent(dataItem.name));
                search_value = dataItem.name;
                break;
              case 'tv':
                selected_item = kendo.format(decodeURI(seach_redirect_template), '/tv', encodeURIComponent(dataItem.name));
                search_value = dataItem.name;
                break;
              case 'person':
                selected_item = kendo.format(decodeURI(seach_redirect_template), '/person', encodeURIComponent(dataItem.name));
                search_value = dataItem.name;
                break;
              default:
                selected_item = kendo.format(decodeURI(seach_redirect_template), '', encodeURIComponent(dataItem));
                search_value = dataItem;
            }
          }

          $("#search_v4").data("kendoAutoComplete").value(search_value);
          window.location = selected_item;
        }

        $("#search_v4").kendoAutoComplete({
          highlightFirst: false,
          minLength: 1,
          dataTextField: "title",
          template: kendo.template($("#slim_multi_search_template").html()),
          noDataTemplate: $("#search_no_data_template").html(),
          dataSource: {
            serverFiltering: true,
            transport: {
              read: '/search/trending?language=tr-TR',
              parameterMap: function() {
                return { query: $("#search_v4").data("kendoAutoComplete").value() };
              }
            },
            schema: {
              data: "results"
            }
          },
          popup: {
            appendTo: $("section.search")
          },
          filtering: function(e) {
            var filter = e.filter != undefined ? e.filter.value : "";
            if (filter == '') {
              if ( ($('#search_v4-list #trending_search_header_template').length) == 0 ) {
                // $('#search_v4_listbox').empty();
                $('#search_v4-list').prepend($("#search_v4_headerTemplate").html());
              }
            } else {
              $("#trending_search_header_template").remove();
            }
          },
          select: function(e) {
            processing_selected_item = true;
            processSelectedItem(e);
          },
          close: function(e) {
            // Use this to prevent the popup from closing in dev.
            // e.preventDefault();
          }
        }).data("kendoAutoComplete");

        $('#search_v4').on("keydown", function(event) {
          if (event.keyCode == 13) {
            if (processing_selected_item) {
              processing_selected_item = false;
              return;
            } else {
              processSelectedItem(null);
            }
          }
        });

        $('header #search_form').submit(function() {
          return false;
        });

        var autocompleteInput = $('section.search .k-autocomplete input');
        autocompleteInput.on('focus', function (e) {
          var value = autocompleteInput.val();
          if (value == null || value == '') {
            $("#search_v4").data("kendoAutoComplete").search('');
          } else {
            var fieldLength = value.length;
            autocompleteInput[0].setSelectionRange(fieldLength, fieldLength);
          }
        });

        $('header.show_search_false li.search_buttons a.search').on('click', function(e) {
          e.preventDefault();
          showSearch(true);
        });

        $('header.show_search_true li.search_buttons a.search').on('click', function(e) {
          e.preventDefault();
          $("#search_v4").data("kendoAutoComplete").focus();
        });

        $('header.show_search_false li.search_buttons a.close').on('click', function(e) {
          e.preventDefault();
          showSearch(false);
        });

        $('main.show_search_false').on('click', function(e) {
          showSearch(false);
        });

        $('header').on('click', '.k-clear-value', function(e) {
          $('#search_v4').data("kendoAutoComplete").focus();
        });


        public_media_type_map = {
          'movie': 'Film',
          'tv': 'Dizi',
          'person': 'Kişi'
        };

        document.addEventListener('keydown', function(e) {
          if (e.target.closest('[contenteditable], input, textarea, select')) return;
          if (e.metaKey || e.altKey) return;

          var key = e.key;

            if (e.ctrlKey) return;

          if (key === 'b' && $('a.keyboard_s.parent').length) { $('a.keyboard_s.parent')[0].click(); return; }
          if (key === 's' && $('#search_v4').length) {
            e.preventDefault();
            if ($('header').hasClass('show_search_false')) { showSearch(true); } else { $('#search_v4').data('kendoAutoComplete').focus(); $('#search_v4').select(); }
            return;
          }
          if (key === '?') { keyboard_shortcut_popup.open(); return; }
          if (key === 'ArrowLeft' && !window.TMDbImageGallery?.overlay && $('span.previous a.keyboard_s').length) { $('span.previous a.keyboard_s')[0].click(); return; }
          if (key === 'ArrowRight' && !window.TMDbImageGallery?.overlay && $('span.next a.keyboard_s').length) { $('span.next a.keyboard_s')[0].click(); return; }
          if (key === 'm' && $('#new_shortcut_bar').length) { $('#new_shortcut_bar').focus(); return; }
        });
      }).catch(function(error) {
        console.error("Error initializing footer Kendo UI", error);
      });

      var gender_lookup = {
        0: 'two',
        1: 'one',
        2: 'two',
        3: 'two'
      }
    </script>

    <script id="person_template" type="text/x-kendo-tmpl">
      <div class="item profile list_item grid_item">
        <div class="image_content profile">
          <a class="result" href="${data.url}" title="${data.name}" alt="${data.name}">
            # if (data.profile_path) { #
              <img class="" src="https://media.themoviedb.org/t/p/w66_and_h66_face${data.profile_path}" alt="${data.name}" width="45" height="45" srcset="https://media.themoviedb.org/t/p/w66_and_h66_face${data.profile_path} 1x, https://media.themoviedb.org/t/p/w132_and_h132_face${data.profile_path} 2x">
            # } else { #
              <div class="glyphicons picture profile ${gender_lookup[data.gender]} grey no_image_holder w45_and_h45"></div>
            # } #
          </a>
        </div>

        <div class="content">
          <p class="name"><a class="result" href="${data.url}" title="${data.name}" alt="${data.name}">${data.name}</a></p>

          # if (data.known_for) { #
            <p class="sub">${data.known_for}</p>
          # } #
        </div>
      </div>
    </script>

    <script id="person_template_with_known_for" type="text/x-kendo-tmpl">
