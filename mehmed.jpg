    <script type="text/javascript" charset="utf-8" >
      window.PageReady().then(function(ready) {

        window.showSearch = function(state) {
          if (state) {
            $('header').removeClass('nav-up').addClass('nav-down');
            $('li.search_buttons a.close').removeClass('hide');
            $('li.search_buttons a.search').addClass('hide');
            $('div.search_bar').removeClass('hide');
            $("#search_v4").data("kendoAutoComplete").focus();
          } else {
            $('li.search_buttons a.close').addClass('hide');
            $('li.search_buttons a.search').removeClass('hide');
            $('div.search_bar').addClass('hide');
          }
        };

        renderTimeago();

        var didScroll;
        var lastScrollTop = 0;
        var delta = 10;
        var navbarHeight = $('header').outerHeight();

        $(window).scroll(function(event){
          didScroll = true;
        });

        setInterval(function() {
          if (didScroll) {
            hasScrolled();
            didScroll = false;
          }
        }, 250);

        function hasScrolled() {
          var st = $(this).scrollTop();

          if ( Math.abs(lastScrollTop - st) <= delta )
            return;

          if ( st > lastScrollTop && st > navbarHeight ) {
            $('header').removeClass('nav-down').addClass('nav-up');
          } else {
            if ( st + $(window).height() < $(document).height() ) {
              $('header').removeClass('nav-up').addClass('nav-down');
            }
          }

          lastScrollTop = st;
        }

        var hover_tooltip = $('li.user a.no_click.tooltip_hover').tmdbTooltip({
          themeClass: "tmdb_theme_white nowrap",
          position: 'bottom',
          show: function(e) {
            this.element.removeClass('keyboard');
          }
        }).data("kendoTooltip");

        $('button').on('click', function(e) {
            var redirect_url = $(this).data('redirect-url');
            if (redirect_url === undefined) {
              return
            }

            window.location = redirect_url;
          });

        $('li.user a.no_click').tmdbTooltip({
          themeClass: "tmdb_theme_white no_pad",
          autoHide: false,
          showOn: 'click',
          width: 180,
          position: 'bottom',
          content: function() {
            return $("#settings_tooltip").html();
          },
          show: function(e) {
            hover_tooltip.hide();
            if (this.element.hasClass('keyboard')) {
              this.popup.element.find('p a')[0].focus();
            }
          }
        });

        var translateUrl = '/translation-popup?language=tr-TR&media_type=TvSeries&media_id=65d1066841eee1017c0844b4&referral=%252Ftv%252F246621-mehmed-fetihler-sultani%252Fimages%252Fposters';

        $("li.translate").on("click", function(e) {
          e.preventDefault();
          var li = $(this);
          var tooltip = li.data("kendoTooltip");

          if (tooltip && tooltip.popup.visible()) {
            tooltip.hide();
            return;
          }

          if (li.find(".translate-loading-spinner").length) return;

          var spinner = $('<span class="translate-loading-spinner"></span>');
          li.append(spinner);

          $.ajax({
            url: translateUrl
          }).done(function(response) {
            spinner.remove();

            if (tooltip) {
              tooltip.destroy();
            }

            li.tmdbTooltip({
              themeClass: "tmdb_theme_white flex",
              autoHide: false,
              content: response,
              showOn: "click",
              width: 300,
              position: "bottom"
            });

            li.data("kendoTooltip").show(li);
          }).fail(function() {
            spinner.remove();
          });
        });

        $("li.new_buttons a").on("click", function(e) {
          e.preventDefault();
          var li = $(this).closest("li.new_buttons");
          var tooltip = li.data("kendoTooltip");

          if (tooltip && tooltip.popup.visible()) {
            tooltip.hide();
            return;
          }

          if (!tooltip) {
            li.tmdbTooltip({
              themeClass: "tmdb_theme_white",
              autoHide: false,
              content: $("#new_media_template").html(),
              showOn: "click",
              position: "bottom"
            });
            tooltip = li.data("kendoTooltip");
          }

          tooltip.show(li);
        });

        $("body").on('click', 'a.no_click', function(e) {
          e.preventDefault();
        });

        $("ul > li").on("mouseenter", function() {
          $(this).find("ul.sub_nav.hide").toggle();
        }).on("mouseleave", function() {
          $(this).find("ul.sub_nav.hide").toggle();
        });


        showSuccess = function(message, title) {
          if (title === undefined) {
            title = 'Başarılı';
          }

          return notify().show({
            title: title,
            message: message
          }, "success");
        };

        showError = function(message, title) {
          if (!message || message === []) {
            message = 'Bir problem oluştu.';
          }

          if (title === undefined) {
            title = 'Hata';
          }

          return notify().show({
            title: title,
            message: message
          }, "error");
        };

        var keyboard_shortcut_popup = $('#keyboard_shortcuts_popup div.content').kendoWindow({
          title: 'Klavye Kısayolları',
          width: mobileDevice ? "100%" : "90vw",
          maxWidth: mobileDevice ? "100%" : "1400px",
          actions: [ "Close" ],
          modal: true,
          draggable: false,
          resizable: false,
          visible: false,
          pinned: true,
          animation: {
            open: {
              effects: "fade:in"
            },
            close: {
              effects: "fade:out"
            }
          },
          open: function() {
            $('body').addClass('monochrome');
          },
          close: function() {
            $('body').removeClass('monochrome');
          }
        }).data("kendoWindow").center();

        $('#keyboard_shortcuts').on('click', function() {
          keyboard_shortcut_popup.open();
        });

          $("#toggle_keyboard_shortcuts").prop({'checked': true, 'disabled': true});
          var keyboard_tooltip = $("label[for='toggle_keyboard_shortcuts']").kendoTooltip({
            position: 'bottom',
            content: "Hesabınıza giriş yaparak klavye kısayollarını devre dışı bırakabilirsiniz."
          }).data("kendoTooltip");

        $("#toggle_keyboard_shortcuts").on('change', function (e) {
          var checkboxState = $(this).prop('checked');
          $.post({
            url: '/settings/toggle-keyboard-shortcuts',
            dataType: "json",
            data: {
              keyboard_shortcuts_enabled: checkboxState
            }
          }).fail(function () {
            showError('Bir problem oluştu.');
          }).done(function (response) {
            if (response.failure) {
              showError('Bir problem oluştu.');
            }
            if (response.success) {
              showSuccess('');
              window.location.reload();
            }
          });
        });

