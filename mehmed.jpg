</div>

<script>
  window.tmdbAuthCard = function(card) {
    if (!card || card._tmdbAuthCardInit) return;
    card._tmdbAuthCardInit = true;

    var title = card.querySelector("[data-auth-title]");
    var panels = {
      login: card.querySelector('[data-auth-panel="login"]'),
      signup: card.querySelector('[data-auth-panel="signup"]'),
      magic_link: card.querySelector('[data-auth-panel="magic_link"]')
    };

    var panelTitles = {
      login: "Giriş",
      signup: "Kaydol",
      magic_link: "Sign in with Email Link"
    };

    function showPanel(target) {
      var resolvedTarget = panels[target] ? target : "login";

      Object.keys(panels).forEach(function(key) {
        var panel = panels[key];
        if (!panel) return;

        if (key === resolvedTarget) {
          panel.removeAttribute("inert");
          panel.removeAttribute("hidden");
        } else {
          panel.setAttribute("inert", "");
          panel.setAttribute("hidden", "");
        }
      });

      if (title) {
        title.textContent = panelTitles[resolvedTarget] || panelTitles.login;
      }
      card.setAttribute("data-auth-mode", resolvedTarget);

      card.querySelectorAll("[data-auth-login-only]").forEach(function(el) {
        el.style.display = (resolvedTarget === "login") ? "" : "none";
      });

      var panel = panels[resolvedTarget];
      if (!panel) return;

      var firstInput = panel.querySelector("input:not([type=hidden])");
      if (firstInput) firstInput.focus();
    }

    card.addEventListener("click", function(e) {
      var onceLink = e.target.closest("[data-auth-once]");
      if (onceLink) {
        if (onceLink.dataset.authClicked) {
          e.preventDefault();
          return;
        }
        onceLink.dataset.authClicked = "true";
        onceLink.style.opacity = "0.5";
        onceLink.style.pointerEvents = "none";
      }

      var switchBtn = e.target.closest("[data-auth-switch]");
      if (switchBtn) showPanel(switchBtn.getAttribute("data-auth-switch"));

      var toggle = e.target.closest("[data-password-toggle]");
      if (!toggle) return;

      var wrap = toggle.closest(".auth-field-wrap");
      if (!wrap) return;

      var input = wrap.querySelector("input");
      var eyeOpen = toggle.querySelector(".auth-eye-open");
      var eyeClosed = toggle.querySelector(".auth-eye-closed");

      if (input.type === "password") {
        input.type = "text";
        eyeOpen.style.display = "none";
        eyeClosed.style.display = "";
        toggle.setAttribute("aria-label", "Hide password");
      } else {
        input.type = "password";
        eyeOpen.style.display = "";
        eyeClosed.style.display = "none";
        toggle.setAttribute("aria-label", "Show password");
      }
    });

    card._showPanel = showPanel;
  };

  (function() {
    var overlay = document.getElementById("auth_modal");
    if (!overlay) return;

    var card = overlay.querySelector(".auth-card");
    window.tmdbAuthCard(card);

    function openModal(mode) {
      overlay.setAttribute("data-open", "");
      document.body.style.overflow = "hidden";
      card._showPanel(mode || "login");
      setTimeout(function() {
        var panel = card.querySelector('[data-auth-panel="' + (mode || "login") + '"]');
        var firstInput = panel.querySelector("input:not([type=hidden])");
        if (firstInput) firstInput.focus();
      }, 50);
    }

    function closeModal() {
      overlay.removeAttribute("data-open");
      document.body.style.overflow = "";
    }

    overlay.querySelector("[data-auth-close]").addEventListener("click", closeModal);

    document.addEventListener("keydown", function(e) {
      if (e.key === "Escape" && overlay.hasAttribute("data-open")) closeModal();
    });

    document.addEventListener("click", function(e) {
      var trigger = e.target.closest("[data-auth-modal]");
      if (!trigger) return;

      e.preventDefault();
      openModal(trigger.getAttribute("data-auth-modal") || "login");
    });

    window.tmdbAuthModal = { open: openModal, close: closeModal };
  })();
</script>

  </body>
</html>

